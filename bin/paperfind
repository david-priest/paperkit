#!/usr/bin/env python3
"""paperfind — is this paper already on this machine?

WHY THIS EXISTS
    Reference managers sync your PDFs into a cloud drive, so they are already on disk --
    but there is no way to search them from a terminal, and a script or AI agent has no
    idea they exist. If sync ever stalls you can also end up with several copies of the
    library in different states; searching the wrong one makes a paper you own look
    missing.

    Configure it with PAPERKIT_STORES or ~/.config/paperkit/stores, or let it discover
    any "Paperpile/All Papers" folder under your home directory.

NAMING
    Paperpile files PDFs as "<Surname> et al. <Year> - <Title>.pdf", by first letter of
    the first author's surname, eliding long titles IN THE MIDDLE with " ... " -- so match
    on surname and year, never a full title. Files renamed by other tools sometimes carry
    no author at all, so extra arguments are searched against the filename as title words.

USAGE
    paperfind Bannard 2013                    # surname + year
    paperfind Shih 2002 BCR affinity          # extra words narrow it, and can match
                                              #   filenames that carry no author
    paperfind Kuraoka 2016 -o                 # open the top hit
    paperfind Hagglof -m                      # no PDF? read the local metadata cache
    paperfind --selftest                      # regression suite

WHY THE MATCHING IS FUSSY
    Every looser version reported a paper as owned when it was not:
      * a bare substring match returned "Long" for *long-lasting* and "Li" for *compared*
      * the year was tested against the whole PATH, so a folder named "2025-06/" satisfied
        a search for 2025 and returned a 2022 paper by the same author
      * title words were used only as a fallback, never to filter surname hits, so
        "Wang 2026 spatial proximity sequencing" returned an unrelated Wang 2026 paper
      * multi-word surnames were not parsed: "de Carvalho 2023" searched for "de"
      * a preprint filed under its bioRxiv year did not match the journal year, so recent
        work looked missing -- hence +/-1 year tolerance, flagged "~year"

EXIT
    0 hits found - 1 nothing found (then try -m, or paperget)
"""
import os
import re
import subprocess
import sys
import unicodedata
from pathlib import Path

HOME = Path.home()
REALM = HOME / "Library/Application Support/Paperpile/realm/paperpile.realm"
AUTHORLESS = re.compile(r"^(19|20)\d{2}[,. ]")
PARTICLES = {"de", "van", "von", "der", "den", "del", "di", "la", "le", "du"}
STOP = {"the", "and", "for", "with", "from", "that", "this", "are", "was", "role", "via",
        "into", "non", "new", "novel", "vivo", "vitro"}


def stores():
    """Where to look for PDFs, most authoritative first.

    In order of precedence:
      1. $PAPERKIT_STORES  -- colon-separated paths
      2. ~/.config/paperkit/stores -- one path per line, '#' comments allowed
      3. auto-discovery: any "Paperpile/All Papers" directory under $HOME, plus
         ~/Downloads as a download inbox

    Paperpile syncs PDFs into Google Drive, so the folder can be under "My Drive",
    "Google Drive", "~/Library/CloudStorage/GoogleDrive-<account>", or a local copy
    left behind after a sync problem. Auto-discovery finds all of them; list them
    explicitly in the config file if you want to control the ranking.
    """
    env = os.environ.get("PAPERKIT_STORES")
    if env:
        return [Path(p).expanduser() for p in env.split(":") if p.strip()]
    cfg = Path.home() / ".config/paperkit/stores"
    if cfg.exists():
        out = [Path(l.strip()).expanduser() for l in cfg.read_text().splitlines()
               if l.strip() and not l.startswith("#")]
        if out:
            return out
    found, home = [], Path.home()
    for pat in ("*/Paperpile/All Papers", "*/*/Paperpile/All Papers",
                "Library/CloudStorage/*/*/Paperpile/All Papers"):
        found += sorted(home.glob(pat))
    # biggest first: after a sync problem the live folder can be nearly empty while a
    # stale local copy holds the real library
    found.sort(key=lambda p: -sum(1 for _ in p.rglob("*.pdf")))
    dl = home / "Downloads"
    return found + ([dl] if dl.exists() else [])


def inbox():
    """Where a freshly downloaded PDF should be saved. Last store, or ~/Downloads."""
    env = os.environ.get("PAPERKIT_INBOX")
    if env:
        return Path(env).expanduser()
    return Path.home() / "Downloads"

STOP = {"the", "and", "for", "with", "from", "that", "this", "are", "was", "role", "via",
        "into", "non", "new", "novel", "vivo", "vitro"}


def fold(x):
    return "".join(c for c in unicodedata.normalize("NFKD", x or "")
                   if not unicodedata.combining(c)).lower()


def all_pdfs():
    out = []
    for st in stores():
        if st.exists():
            out += [p for p in st.rglob("*.pdf") if ".Trash" not in str(p)]
    return out


def surname_ok(base, surname):
    """The surname must sit where a surname sits: at the start, or after '/' or '- '."""
    return re.search(r"(^|[/(]|-\s|\band\s)" + re.escape(fold(surname)) +
                     r"( et al\.?| and | \d{4}|,|\s)", fold(base)) is not None


def year_ok(base, year):
    """Year must appear in the BASENAME, not the path -- the inbox is foldered YYYY-MM,
    so a path test let '2025-06/' satisfy a search for 2025 and return a 2022 paper."""
    if not year:
        return True, 0
    yrs = [int(y) for y in re.findall(r"\b(19|20)\d{2}\b", base)] or \
          [int(m.group(0)) for m in re.finditer(r"\b(?:19|20)\d{2}\b", base)]
    yrs = [int(m.group(0)) for m in re.finditer(r"\b(?:19|20)\d{2}\b", base)]
    if not yrs:
        return False, 9
    d = min(abs(y - int(year)) for y in yrs)
    return d <= 1, d          # +/-1: a preprint on disk under its bioRxiv year


def parse_query(a):
    """"Surname Year title words" -> (surname, year, words), handling multi-word surnames.

    "de Carvalho 2023 clonal replacement" used to yield surname "de" -- which matched
    "Ghoneim 2017 - De Novo Epigenetic..." -- and dropped the year entirely because
    "Carvalho" is not a four-digit number. Same for "Manakkat Vijay 2026".
    """
    parts = list(a)
    surname = parts.pop(0)
    while parts:
        nxt = parts[0]
        low = surname.split()[-1].lower() in PARTICLES
        # absorb a capitalised word if a year (or nothing) follows it: "Manakkat Vijay 2026"
        two = (nxt[:1].isupper() and not re.fullmatch(r"(19|20)\d{2}", nxt)
               and (len(parts) == 1 or re.fullmatch(r"(19|20)\d{2}", parts[1])))
        if not (low or two):
            break
        surname += " " + parts.pop(0)
    year = parts.pop(0) if parts and re.fullmatch(r"(19|20)\d{2}", parts[0]) else None
    return surname, year, parts


def title_overlap(base, words):
    keys = {fold(w) for w in words if len(w) > 3 and w.lower() not in STOP}
    if not keys:
        return None                      # nothing to judge on
    fb = fold(base)
    return sum(1 for k in keys if k in fb) / len(keys)


def search(surname, year, words):
    """(exact_hits, loose_hits). Title words FILTER surname hits as well as backfilling.

    Using them only as a fallback meant a common surname plus a year returned the wrong
    paper with full confidence: "Wang 2026 spatial proximity sequencing" produced
    "Wang 2026, EBV infection HLA-DR15", and "Hagglof 2023 continuous germinal center"
    produced the 2022 T-bet adipose paper.
    """
    exact, loose = [], []
    for p in all_pdfs():
        b = p.name
        ok_y, dy = year_ok(b, year)
        ov = title_overlap(b, words)
        if surname and surname_ok(b, surname) and ok_y:
            if ov is None or ov >= 0.4:
                exact.append((dy, -(ov or 0), p))
        elif ov is not None and ov >= 0.8 and ok_y and AUTHORLESS.match(b):
            # Title-only matching exists for ONE case: files another tool renamed without
            # an author, e.g. "2002, Role BCR affinity T cell dependent.pdf". Allowing it
            # on any filename made it answer "Wang 2026 spatial proximity sequencing" with
            # "Cheng 2025, Sequencing-free whole-genome spatial transcriptomics" -- a
            # different author's paper, presented with full confidence. The bar is high
            # (0.8) because query words are often generic: "continuous germinal center"
            # scored 0.67 against "2024, Germinal-center development memory B.pdf" on
            # nothing but the two words every paper in this field shares.
            loose.append((0, -ov, p))
    rank = {str(s): i for i, s in enumerate(stores())}
    def key(t):
        return (t[0], t[1], next((i for s, i in rank.items()
                                  if str(t[2]).startswith(s)), 9))
    trim = lambda L: [(d, p) for d, _, p in sorted(L, key=key)]
    return trim(exact), trim(loose)


CASES = [
    # (args, must_not_return_substring, must_return_substring). Add cases for your own
    # library -- every one in the private original was a real failure, and they are why
    # the matching is fussy. Run: paperfind --selftest
    (["Zzzzqqq", "2020"], None, None),        # a nonsense query must return nothing
]


def selftest():
    bad = 0
    for args, forbid, need in CASES:
        sn, yr, wd = parse_query(args)
        ex, lo = search(sn, yr, wd)
        got = [str(p) for _, p in ex + lo]
        joined = " | ".join(Path(g).name for g in got)
        ok = True
        if forbid and any(forbid in g for g in got):
            ok = False
        if need and not any(need.lower() in g.lower() for g in got):
            ok = False
        if not need and not forbid and got:
            ok = False
        bad += not ok
        print(f"  {'ok  ' if ok else 'FAIL'} {' '.join(args):<34} -> {joined[:70] or '(none)'}")
    print(f"\n{len(CASES) - bad}/{len(CASES)} passed")
    return 1 if bad else 0


def main():
    a = sys.argv[1:]
    if "--selftest" in a:
        return selftest()
    op = "-o" in a or "--open" in a
    meta = "-m" in a or "--meta" in a
    a = [x for x in a if not x.startswith("-")]
    if not a:
        print(__doc__.split("USAGE")[1].split("WHY THE MATCHING")[0].rstrip())
        return 1
    surname, year, words = parse_query(a)
    exact, loose = search(surname, year, words)
    hits = exact or loose
    if hits:
        for dy, p in hits:
            flag = "  ~year" if dy else ""
            print(str(p).replace(str(HOME), "~") + flag)
        if not exact:
            print("  ^ matched on title words, not the surname "
                  "(filed without an author)", file=sys.stderr)
        if op:
            subprocess.run(["open", str(hits[0][1])])
        return 0

    print(f"no PDF found for '{surname}'{(' ' + year) if year else ''}", file=sys.stderr)
    if meta and REALM.exists():
        print("--- Paperpile metadata cache ---", file=sys.stderr)
        r = subprocess.run(["strings", "-n", "20", str(REALM)],
                           capture_output=True, text=True)
        seen = sorted({l for l in r.stdout.splitlines() if surname.lower() in l.lower()})
        print("\n".join(seen[:20]))
    else:
        print(f"try: paperfind {surname}{(' ' + year) if year else ''} <title words>  "
              f"or add -m to search the metadata cache", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
